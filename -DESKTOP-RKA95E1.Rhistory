filter(Diferencial_mmCa_800dPT8102 == 0,
`Data Hora` >= i_time & `Data Hora` < f_time) %>%
select(`Data Hora`) %>%
pull() %>% median()
df_thin <- df %>%
filter(`Data Hora` >= x_0 & `Data Hora` < f_time)
index <- seq(1,nrow(df_thin),by=11)
df_thin <- df_thin[index,]
plot(df_thin$`Data Hora`,df_thin$Diferencial_mmCa_800dPT8102)
##
t_aux <- ymd_hms("2024-05-04 14:43:11")
df %>% filter(`Data Hora` %in% c(t_aux,t_aux + hms("00:00:26")))
View(df)
View(df_thin)
library(readxl)
library(dplyr)
library(lubridate)
df <- read_excel("Copy of Filtro Manga - Dados de processo.xlsx")
df <- df[-1,]
i_time <- ymd_hms("2024-05-04 10:50:00")
f_time <- ymd_hms("2024-05-04 20:00:00")
##
df_aux <- df %>%
filter(Diferencial_mmCa_800dPT8102 == 0,
`Data Hora` >= i_time & `Data Hora` < f_time)
plot(df_aux$`Data Hora`,df_aux$Diferencial_mmCa_800dPT8102)
x_0 <- df %>%
filter(Diferencial_mmCa_800dPT8102 == 0,
`Data Hora` >= i_time & `Data Hora` < f_time) %>%
select(`Data Hora`) %>%
pull() %>% median()
df_thin <- df %>%
filter(`Data Hora` >= x_0 & `Data Hora` < f_time)
index <- seq(1,nrow(df_thin),by=11)
df_thin <- df_thin[index,]
plot(df_thin$`Data Hora`,df_thin$Diferencial_mmCa_800dPT8102)
##
t_aux <- ymd_hms("2024-05-04 14:43:11")
df %>% filter(`Data Hora` %in% c(t_aux,t_aux + hms("00:00:26")))
View(df_thin)
